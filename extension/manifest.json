{
  "manifest_version": 3,
  "name": "fsociety NET",
  "short_name": "fsociety",
  "version": "0.1.0",
  "description": "VPN для браузера от fsociety NET: Chrome и Яндекс Браузер. Работает по подписке fsociety NET.",
  "minimum_chrome_version": "108",
  "icons": { "16": "icons/on-16.png", "32": "icons/on-32.png", "48": "icons/on-48.png", "128": "icons/on-128.png" },
  "action": {
    "default_title": "fsociety NET",
    "default_popup": "popup.html",
    "default_icon": { "16": "icons/off-16.png", "32": "icons/off-32.png", "48": "icons/off-48.png" }
  },
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["proxy", "privacy", "storage", "alarms", "webRequest", "webRequestAuthProvider"],
  "host_permissions": ["<all_urls>"]
}
